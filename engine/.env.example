ACME_EMAIL=monapi@projektsued.de

# Local: localhost
# Prod:  api.monapi.io (make sure DNS points to the host before enabling TLS)
PUBLIC_HOST=localhost

API_KEY_HEADER=X-API-Key
API_KEY_PEPPER=change-me
BOOTSTRAP_API_KEYS=dev-key-1,dev-key-2

SQLITE_PATH=/data/monapi.sqlite3
INDEX_DIR=/data/index
FEEDS_CONFIG=/app/app/data/feeds.yaml
POLICIES_CONFIG=/app/app/data/policies.yaml

WORKER_INTERVAL_SECONDS=900

RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_EMAIL=10/minute

# Enrichment: null | geoip
ENRICHER=geoip
GEOIP_MMDB_PATH=/data/geoip/ip66.mmdb
GEOIP_URL=https://downloads.ip66.dev/db/ip66.mmdb
GEOIP_MAX_AGE_SECONDS=86400
RDNS_ENABLED=true
RDNS_TIMEOUT_SECONDS=2.0

# Email verification: null | reoon
EMAIL_VERIFIER=null
REOON_API_KEY=
REOON_MODE=quick

LOG_LEVEL=INFO
